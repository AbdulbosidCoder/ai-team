# Скопируйте в .env и заполните:  cp .env.example .env
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID (узнать: /whoami у бота). Через запятую — несколько человек. Пусто = всем.
ALLOWED_USER_IDS=
# Ключ Claude API (необязательно). Без него бот работает на встроенных правилах.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# auto | yes | no
USE_CLAUDE=auto
# Часовой пояс, время утреннего отчёта, рабочий день
TZ_NAME=Asia/Tashkent
DAILY_TIME=08:00
WORK_START=09:00
WORK_END=19:00
# Площадки для content plan
PLATFORMS=Instagram, Telegram, YouTube Shorts
# Расходы: каждые 15 минут читать SMS от Uzcard/Humo (только Android + Termux:API)
SMS_AUTO_IMPORT=0
# Отправители SMS (через запятую, часть имени/номера)
CARD_SMS_SENDERS=humo,uzcard,cardxabar,6464,kapitalbank,hamkorbank,agrobank,nbu,xalqbank,asakabank,tbc,anorbank
# Месячный бюджет в сумах (0 = не считать остаток)
MONTHLY_BUDGET=0
# Монтаж на Android: whisper.cpp (заполняет setup-montaj.sh). Язык речи: en | uz | ru | auto (для не-en нужна модель base/small)
WHISPER_CPP=
WHISPER_CPP_MODEL=
WHISPER_LANG=en
# Длина и цвет Reel. Пусто = из brain/memory.jsonl (Brand rules: 45 с, #FFD400)
EDIT_MAX=
EDIT_COLOR=
# Postgres (Neon/Supabase) вместо файлов — для Render free. Пусто = файлы.
DATABASE_URL=
# Webhook-режим (на Render задаётся автоматически через RENDER_EXTERNAL_URL)
WEBHOOK_URL=
